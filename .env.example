# DB接続情報。このファイルを .env にコピーして各環境の値を設定する。
# .env はリポジトリにコミットしないこと（.gitignore 済み）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enque
DB_USER=enque_app
DB_PASS=change-me

# QRコード・メール本文に埋め込む公開URL（末尾スラッシュ無し）
BASE_URL=https://survey.example.jp

# 1 なら /s/<イベント>/<企業> 形式、0 なら /s.php?e=...&c=... 形式でURLを発行する
# （0 にするのは mod_rewrite が使えない環境のみ）
PRETTY_URLS=1

# HTTPSで運用する場合は 1（セッションCookieに Secure 属性を付与）
SESSION_SECURE=0

# 本番では 0（画面にエラーを出さずログのみに記録）
DISPLAY_ERRORS=0

# 全体アンケート案内メールの送信元
MAIL_FROM=no-reply@example.jp
MAIL_FROM_NAME=イベント事務局

# 送信方式を選ぶ
#   postfix … ローカルのpostfix（sendmailコマンド）に渡し、中継はサーバーに任せる【既定・推奨】
#   smtp    … 外部SMTPサーバーへ直接接続する（下の SMTP_* を設定する）
#   log     … 送信せず logs/mail-dryrun.log に書き出す（開発・動作確認用）
MAIL_TRANSPORT=postfix

# postfix を使う場合の sendmail コマンド（Debian の postfix なら既定のままでよい）
SENDMAIL_PATH=/usr/sbin/sendmail

# MAIL_TRANSPORT=smtp のときだけ使う設定。
# ローカルpostfixにSMTPで繋いで中継させる場合は
#   SMTP_HOST=127.0.0.1 / SMTP_PORT=25 / SMTP_SECURE=none / 認証なし
SMTP_HOST=
SMTP_PORT=587
# none / tls（STARTTLS） / ssl（SMTPS, 通常は465）
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# 1通送るごとの待機ミリ秒（送信先・中継元のレート制限に合わせる。postfixでも有効）
SMTP_THROTTLE_MS=200
