# DB接続情報。このファイルを .env にコピーして各環境の値を設定する。
# .env はリポジトリにコミットしないこと（.gitignore 済み）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enque
DB_USER=enque_app
DB_PASS=change-me

# QRコード・メール本文に埋め込む公開URL（末尾スラッシュ無し）
BASE_URL=https://survey.example.jp

# 1 なら /s/<イベント>/<企業> 形式、0 なら /s.php?e=...&c=... 形式でURLを発行する
# （0 にするのは mod_rewrite が使えない環境のみ）
PRETTY_URLS=1

# HTTPSで運用する場合は 1（セッションCookieに Secure 属性を付与）
SESSION_SECURE=0

# 本番では 0（画面にエラーを出さずログのみに記録）
DISPLAY_ERRORS=0

# 全体アンケート案内メールの送信元と外部SMTPサーバー
MAIL_FROM=no-reply@example.jp
MAIL_FROM_NAME=イベント事務局
SMTP_HOST=smtp.example.jp
SMTP_PORT=587
# none / tls（STARTTLS） / ssl（SMTPS, 通常は465）
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
# 1通送るごとの待機ミリ秒（送信元サーバーのレート制限に合わせる）
SMTP_THROTTLE_MS=200
