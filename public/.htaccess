# DocumentRoot（public/）用のApache設定
Options -Indexes

# ドットファイル（.env など）への直接アクセスを拒否
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 短いURLの書き換え
#   /s/<イベント>/<企業>  → s.php?e=...&c=...
#   /o/<トークン>         → o.php?t=...
# mod_rewrite が使えない環境では .env の PRETTY_URLS=0 にすると
# QR・メールのURLが .php 形式で発行される。
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^s/([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/?$ s.php?e=$1&c=$2 [L,QSA]
    RewriteRule ^o/([A-Za-z0-9]+)/?$ o.php?t=$1 [L,QSA]
</IfModule>
